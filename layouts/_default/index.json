{{- /* Search index for Fuse.js.

     Built by iterating the front matter rather than listing every field by
     hand, so a schema change in tools/schema.py needs no edit here. Only real
     corpus entries are included - /team/, /contribute/ and the chart page used
     to leak in as empty search hits. */ -}}
{{- $entries := slice -}}
{{- range $page := where .Site.RegularPages "Section" "papers" -}}
  {{- with $page.Params.name -}}
    {{- $entries = $entries | append (merge $page.Params (dict "relpermalink" $page.RelPermalink)) -}}
  {{- end -}}
{{- end -}}
{{ $entries | jsonify }}
